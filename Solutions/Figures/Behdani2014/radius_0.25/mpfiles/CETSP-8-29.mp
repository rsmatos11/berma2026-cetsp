v1 = (  0.07282694574326162*u, 0.25218956830339218*u);
v2 = (  0.21199104893461732*u, 0.11547017129670885*u);
v3 = (  0.60366640701264140*u, 0.05974128634385483*u);
v4 = (  0.62915234345978988*u, 0.13387756734259845*u);
v5 = (  0.68126748437693474*u, 0.28547579247898508*u);
v6 = (  0.96967583781936872*u, 0.55941142030962221*u);
