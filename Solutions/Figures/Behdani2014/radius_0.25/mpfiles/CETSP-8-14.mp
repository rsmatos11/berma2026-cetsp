r7 =  0.03370430538797026*u;
r8 =  0.03370430538797026*u;
r9 =  0.00000000000000000*u;
v1 = (  0.62127752799142566*u, 0.58492676054439197*u);
v2 = (  0.71890950710547430*u, 0.64146490390194755*u);
v3 = (  0.90606018100459051*u, 0.48991954509346203*u);
v4 = (  0.96637154700685557*u, 0.41276630478055132*u);
v5 = (  0.77750861012430150*u, 0.04430794397043459*u);
v6 = (  0.33606725119717695*u, 0.13290186497704737*u);
v7 = (  0.18107865576963783*u, 0.22969874685525352*u);
