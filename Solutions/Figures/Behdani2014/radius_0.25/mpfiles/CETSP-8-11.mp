r8 =  0.04392823882904887*u;
r9 =  0.00000000000000000*u;
v1 = (  0.81231132821422924*u, 0.46790515014672029*u);
v2 = (  0.86885125449491307*u, 0.15688717549006342*u);
v3 = (  0.27588423369805487*u, 0.31524358553996595*u);
v4 = (  0.15218716511957267*u, 0.39468433691773125*u);
