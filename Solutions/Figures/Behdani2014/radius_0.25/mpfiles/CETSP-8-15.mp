v1 = (  0.08925799375685481*u, 0.05385521246379257*u);
v2 = (  0.44488142462969993*u, 0.21890374425398634*u);
v3 = (  0.61449506499339124*u, 0.29762319826998790*u);
v4 = (  0.82323549489313541*u, 0.23682843039589135*u);
v5 = (  0.96493246911267194*u, 0.51146559657885493*u);
v6 = (  0.92287098796957179*u, 0.65818914409825924*u);
