r7 =  0.03839980339300663*u;
r8 =  0.03839980339300663*u;
r9 =  0.00000000000000000*u;
v1 = (  0.98597639180087404*u, 0.61967989923891598*u);
v2 = (  0.97311519671136415*u, 0.67406318335629645*u);
v3 = (  0.64508674973035673*u, 0.48842867099478532*u);
v4 = (  0.17808408728705391*u, 0.64058220045327141*u);
v5 = (  0.15934659151717626*u, 0.48875181471027351*u);
v6 = (  0.09862550956815581*u, 0.33683405149836032*u);
v7 = (  0.49861570551881979*u, 0.21359140754679018*u);
