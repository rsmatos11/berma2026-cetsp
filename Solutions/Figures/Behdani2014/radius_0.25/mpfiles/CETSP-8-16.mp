v1 = (  0.32070983386440610*u, 0.63060649178006245*u);
v2 = (  0.64596016273572621*u, 0.62297887598195023*u);
v3 = (  0.96689278640253318*u, 0.37130408271976062*u);
v4 = (  0.84617085311482532*u, 0.33534984073047558*u);
v5 = (  0.69301221951595560*u, 0.23082705921367830*u);
v6 = (  0.25033014074463750*u, 0.17905523055118006*u);
