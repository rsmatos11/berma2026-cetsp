v1 = (  1.00000000000000000*u, 0.03249592399508867*u);
v2 = (  0.96836798106781274*u, 0.20933959004468511*u);
v3 = (  0.90890993223861583*u, 0.54174895517736499*u);
v4 = (  0.68250330510859281*u, 0.47176758520252549*u);
v5 = (  0.66585731527867797*u, 0.41987666746804614*u);
