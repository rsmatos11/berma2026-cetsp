r7 =  0.03727059946032172*u;
r8 =  0.03727059946032172*u;
r9 =  0.00000000000000000*u;
v1 = (  0.00149232225651117*u, 0.42010301593690830*u);
v2 = (  0.21390397290964114*u, 0.62271127124945957*u);
v3 = (  0.22989944165414372*u, 0.62146930936900868*u);
v4 = (  0.41747612554109453*u, 0.64922796337634359*u);
v5 = (  0.96384192811641844*u, 0.55018585400435316*u);
v6 = (  0.83623267663983181*u, 0.39772547046327356*u);
