r8 =  0.03403143143006881*u;
r9 =  0.00000000000000000*u;
v1 = (  0.40024706819218236*u, 0.47272380770879990*u);
v2 = (  0.18913273808831838*u, 0.64630981764318729*u);
v3 = (  0.10425667597966282*u, 0.53246771248497515*u);
v4 = (  0.24589139422357292*u, 0.34929982327293885*u);
v5 = (  0.24640016277356167*u, 0.31107154663388309*u);
v6 = (  0.25028256480442135*u, 0.11799626650129660*u);
v7 = (  0.97071483361815381*u, 0.08461827866372180*u);
