v1 = (  0.00416623196448391*u, 0.52069436736958929*u);
v2 = (  0.15406244652809378*u, 0.42441415863249166*u);
v3 = (  0.11054659703496116*u, 0.28734510356943671*u);
v4 = (  0.05748042123744451*u, 0.18411722742112929*u);
