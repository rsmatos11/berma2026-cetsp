v1 = (  0.14313688629883761*u, 0.43206128395525895*u);
v2 = (  0.04576948235047153*u, 0.53871112750997896*u);
v3 = (  0.29153164039771906*u, 0.56245499977485358*u);
v4 = (  0.64714447005188447*u, 0.45838833396835538*u);
v5 = (  0.72825033552934171*u, 0.47175830733383461*u);
v6 = (  0.97105190872600800*u, 0.38019174358761781*u);
