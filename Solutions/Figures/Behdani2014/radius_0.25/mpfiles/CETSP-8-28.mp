v1 = (  0.94835836853909150*u, 0.29693970687946591*u);
v2 = (  0.96742364147935900*u, 0.35326997585106656*u);
v3 = (  0.95245054826422582*u, 0.41915720473224066*u);
v4 = (  0.61342791546269493*u, 0.33679953576292182*u);
