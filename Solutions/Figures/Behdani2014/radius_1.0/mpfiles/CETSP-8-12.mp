v1 = (  0.97325305767962433*u, 0.03162675739034472*u);
v2 = (  0.91675512487034660*u, 0.25216766164765347*u);
v3 = (  0.85658009026740412*u, 0.48706221238933256*u);
v4 = (  0.66944198614108752*u, 0.46195510432006220*u);
v5 = (  0.66109502701761147*u, 0.46083524684508842*u);
v6 = (  0.65274806789420070*u, 0.45971538937011469*u);
