prologues := 3;
outputtemplate := "%j.mps";
beginfig(1);
u = 10.0cm;
pair w[];
pair v[];
numeric r[];
number_of_balls = 9;
color lavanda;  lavanda = (235/255,200/255,231/255);
color orange;  orange = (255/255,165/255,0/255);
color vermelho_carmesim; vermelho_carmesim = (139/255, 0/255, 0/255);
color roxo_ameixa; roxo_ameixa = (93/255, 58/255, 155/255);
w1 = (  0.49078218388430966*u, 0.17815525674535507*u);
w2 = (  0.82694247936419885*u, 0.42875028763267969*u);
w3 = (  0.90239369391162727*u, 0.54618820322502604*u);
w4 = (  0.50916353466637554*u, 0.08398166231038368*u);
