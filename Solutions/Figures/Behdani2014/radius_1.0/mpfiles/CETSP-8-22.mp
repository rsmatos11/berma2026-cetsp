w7 = (  0.39517925966316780*u, 0.26816638370118845*u);
w8 = (  0.93803675659598729*u, 0.51874635965945004*u);
w9 = (  0.05334204949623883*u, 0.05045257952982291*u);
r1 =  0.12392648680802548*u;
