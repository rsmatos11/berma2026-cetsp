v1 = (  0.93873442061042656*u, 0.08591741617260815*u);
v2 = (  0.32373696504761779*u, 0.16480293734817716*u);
v3 = (  0.22231778159858995*u, 0.13707453731703578*u);
v4 = (  0.05222944648276776*u, 0.09057172358571539*u);
v5 = (  0.16657126278210105*u, 0.44180846285295289*u);
