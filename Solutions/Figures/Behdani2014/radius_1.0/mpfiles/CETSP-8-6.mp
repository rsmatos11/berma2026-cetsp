v1 = (  0.93405375450263228*u, 0.41353098734644872*u);
v2 = (  0.87864394712463856*u, 0.38783124734318047*u);
v3 = (  0.80717412256744181*u, 0.35468267679021814*u);
v4 = (  0.74959359600386488*u, 0.33790565138862244*u);
v5 = (  0.24641193554134605*u, 0.19129546904050415*u);
v6 = (  0.21079135566376081*u, 0.26509126367421898*u);
v7 = (  0.22552686071701086*u, 0.30629357154222708*u);
