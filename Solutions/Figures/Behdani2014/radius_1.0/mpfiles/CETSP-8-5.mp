v1 = (  0.16420094984756281*u, 0.39919590909643016*u);
v2 = (  0.17651351288756087*u, 0.50309296153761129*u);
v3 = (  0.17945124941284357*u, 0.52788245214468765*u);
v4 = (  0.20877008028665475*u, 0.52258864333327260*u);
v5 = (  0.88006304940719549*u, 0.40137996859854969*u);
