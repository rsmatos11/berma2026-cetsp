v1 = (  0.06945353706288522*u, 0.24050792395963286*u);
v2 = (  0.21603656900669488*u, 0.15446602271279813*u);
v3 = (  0.52570487414399003*u, 0.10673402187198142*u);
v4 = (  0.56113921794841704*u, 0.10127220320923452*u);
v5 = (  0.69823851897779055*u, 0.27512127670701725*u);
v6 = (  0.88426371759946631*u, 0.51101094342891906*u);
