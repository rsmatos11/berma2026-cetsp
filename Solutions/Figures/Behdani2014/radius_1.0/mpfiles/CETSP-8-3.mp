v1 = (  0.29492601593928947*u, 0.20584048247162848*u);
v2 = (  0.43771894928494770*u, 0.13001290444160557*u);
v3 = (  0.58670314599502849*u, 0.10938022519397880*u);
v4 = (  0.73568734270510927*u, 0.08874754594635205*u);
