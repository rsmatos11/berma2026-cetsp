w7 = (  0.12859250589340765*u, 0.51529978074875127*u);
w8 = (  0.12448690262277247*u, 0.36079771187418608*u);
w9 = (  0.76209508580471796*u, 0.43897973986581162*u);
r1 =  0.16485056296467254*u;
