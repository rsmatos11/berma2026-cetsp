v1 = (  0.14202036550003372*u, 0.57122665048216326*u);
v2 = (  0.40396364846024679*u, 0.51277933406864917*u);
v3 = (  0.75444786781313633*u, 0.51292709066909437*u);
v4 = (  0.81015512657380795*u, 0.46267690954386670*u);
