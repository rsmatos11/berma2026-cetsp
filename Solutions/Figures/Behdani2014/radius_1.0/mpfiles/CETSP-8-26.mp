v1 = (  0.38080791073868536*u, 0.44976460760378961*u);
v2 = (  0.19205455923787262*u, 0.56777879233443207*u);
v3 = (  0.14727897773602378*u, 0.49857279728473092*u);
v4 = (  0.19200173019640857*u, 0.36796667064524069*u);
