r8 =  0.11893151923122665*u;
r9 =  0.00000000000000000*u;
v1 = (  0.14016139007159675*u, 0.09865310054470634*u);
v2 = (  0.14534593843147164*u, 0.05287012414880711*u);
v3 = (  0.44549532533134317*u, 0.15228830803209958*u);
v4 = (  0.88117207961537536*u, 0.26152551032593180*u);
v5 = (  0.56633267858953151*u, 0.30191596582645508*u);
v6 = (  0.45365908558817580*u, 0.31116199930651028*u);
