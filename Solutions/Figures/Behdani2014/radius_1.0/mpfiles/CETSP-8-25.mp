v1 = (  0.13671185324834664*u, 0.41266720531466022*u);
v2 = (  0.08269697778789238*u, 0.49199799157458779*u);
v3 = (  0.27380839726570305*u, 0.49256024192626507*u);
v4 = (  0.55825997472071098*u, 0.43333619901666814*u);
v5 = (  0.68144078226196247*u, 0.40768942462812341*u);
