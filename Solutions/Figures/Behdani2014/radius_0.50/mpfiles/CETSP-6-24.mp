prologues := 3;
outputtemplate := "%j.mps";
beginfig(1);
u = 10.0cm;
pair w[];
pair v[];
numeric r[];
number_of_balls = 7;
color lavanda;  lavanda = (235/255,200/255,231/255);
color orange;  orange = (255/255,165/255,0/255);
color vermelho_carmesim; vermelho_carmesim = (139/255, 0/255, 0/255);
color roxo_ameixa; roxo_ameixa = (93/255, 58/255, 155/255);
w1 = (  0.96820855189953903*u, 0.38911969480209829*u);
w2 = (  0.02831511683357177*u, 0.20972436814496900*u);
w3 = (  0.05687865204260054*u, 0.40642823080591323*u);
w4 = (  0.13390685105706565*u, 0.53859291050707359*u);
w5 = (  0.87928787156254973*u, 0.37951422667302498*u);
w6 = (  0.73414719440470522*u, 0.54297822285805120*u);
w7 = (  0.13390685105706565*u, 0.47259767922428869*u);
r1 =  0.06358289620092196*u;
r2 =  0.06358289620092196*u;
r3 =  0.06358289620092196*u;
r4 =  0.06358289620092196*u;
r5 =  0.06358289620092196*u;
r6 =  0.06358289620092196*u;
r7 =  0.00000000000000000*u;
v1 = (  0.13390685105706565*u, 0.47259767922428869*u);
v2 = (  0.08639936735679543*u, 0.39462892829845814*u);
v3 = (  0.05114985532843746*u, 0.23184383672350978*u);
v4 = (  0.84753555930414881*u, 0.37793725534503264*u);
v5 = (  0.93684543431734235*u, 0.39432075506405984*u);
v6 = (  0.72613302363382615*u, 0.51221348266444133*u);
v7 = (  0.15127297910023843*u, 0.51196372033705295*u);
fill fullcircle scaled r1 shifted w1 withcolor lavanda;
fill fullcircle scaled r2 shifted w2 withcolor lavanda;
fill fullcircle scaled r3 shifted w3 withcolor lavanda;
fill fullcircle scaled r4 shifted w4 withcolor lavanda;
fill fullcircle scaled r5 shifted w5 withcolor lavanda;
fill fullcircle scaled r6 shifted w6 withcolor lavanda;
fill fullcircle scaled r7 shifted w7 withcolor lavanda;
draw fullcircle scaled r1 shifted w1 withpen pencircle scaled 0.5pt withcolor black;
draw fullcircle scaled r2 shifted w2 withpen pencircle scaled 0.5pt withcolor black;
draw fullcircle scaled r3 shifted w3 withpen pencircle scaled 0.5pt withcolor black;
draw fullcircle scaled r4 shifted w4 withpen pencircle scaled 0.5pt withcolor black;
draw fullcircle scaled r5 shifted w5 withpen pencircle scaled 0.5pt withcolor black;
draw fullcircle scaled r6 shifted w6 withpen pencircle scaled 0.5pt withcolor black;
draw fullcircle scaled r7 shifted w7 withpen pencircle scaled 0.5pt withcolor black;
draw v1--v2 withpen pencircle scaled 0.5pt withcolor blue;
draw v2--v3 withpen pencircle scaled 0.5pt withcolor blue;
draw v3--v4 withpen pencircle scaled 0.5pt withcolor blue;
draw v4--v5 withpen pencircle scaled 0.5pt withcolor blue;
draw v5--v6 withpen pencircle scaled 0.5pt withcolor blue;
draw v6--v7 withpen pencircle scaled 0.5pt withcolor blue;
draw v7--v1 withpen pencircle scaled 0.5pt withcolor blue;
drawdot w1 withpen pencircle scaled 0.75pt withcolor black;
drawdot w2 withpen pencircle scaled 0.75pt withcolor black;
drawdot w3 withpen pencircle scaled 0.75pt withcolor black;
drawdot w4 withpen pencircle scaled 0.75pt withcolor black;
drawdot w5 withpen pencircle scaled 0.75pt withcolor black;
drawdot w6 withpen pencircle scaled 0.75pt withcolor black;
drawdot w7 withpen pencircle scaled 0.75pt withcolor black;
drawdot v1 withpen pencircle scaled 1.5pt withcolor orange;
drawdot v2 withpen pencircle scaled 1.5pt withcolor red;
drawdot v3 withpen pencircle scaled 1.5pt withcolor red;
drawdot v4 withpen pencircle scaled 1.5pt withcolor red;
drawdot v5 withpen pencircle scaled 1.5pt withcolor red;
drawdot v6 withpen pencircle scaled 1.5pt withcolor red;
drawdot v7 withpen pencircle scaled 1.5pt withcolor red;
endfig;
end;
