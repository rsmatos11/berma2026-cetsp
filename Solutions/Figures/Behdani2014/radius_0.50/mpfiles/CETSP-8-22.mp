v1 = (  0.05504751064673308*u, 0.05206565805123221*u);
v2 = (  0.12791999489001574*u, 0.17305169106160398*u);
v3 = (  0.35888508038858979*u, 0.55650986115905521*u);
v4 = (  0.94439273362685916*u, 0.51380038754639157*u);
v5 = (  0.93739177408674690*u, 0.16845105508837108*u);
