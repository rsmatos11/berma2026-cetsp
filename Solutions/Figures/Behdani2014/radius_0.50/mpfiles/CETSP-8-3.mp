v1 = (  0.30550267889802973*u, 0.21322235212267704*u);
v2 = (  0.44185517218106057*u, 0.10071919537766365*u);
v3 = (  0.55502067644190700*u, 0.11146090534337950*u);
v4 = (  0.76442707841884050*u, 0.07384802751217519*u);
