r7 =  0.06415026558209951*u;
r8 =  0.06415026558209951*u;
r9 =  0.00000000000000000*u;
v1 = (  0.93314900823689417*u, 0.29217751661491875*u);
v2 = (  0.93588540338059067*u, 0.34526740630642017*u);
v3 = (  0.92794963886505344*u, 0.39930039452875216*u);
v4 = (  0.60487735248479635*u, 0.31401791752335068*u);
v5 = (  0.58087978145364505*u, 0.30260141510873467*u);
v6 = (  0.18060367118421389*u, 0.38924110581271970*u);
