v1 = (  0.96740236155799542*u, 0.60800623921512487*u);
v2 = (  0.94979346990392510*u, 0.64309662568054915*u);
v3 = (  0.63145830288488358*u, 0.49801003262815635*u);
v4 = (  0.18374572311629206*u, 0.61194959712822794*u);
v5 = (  0.14817216849128545*u, 0.47640207182557326*u);
v6 = (  0.11259861386627885*u, 0.34085454652291858*u);
