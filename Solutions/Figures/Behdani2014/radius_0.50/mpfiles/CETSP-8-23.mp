v1 = (  0.73708618979864615*u, 0.72616479110076315*u);
v2 = (  0.70335372162436927*u, 0.78616413751080061*u);
v3 = (  0.56208923628698315*u, 0.78651038346733926*u);
v4 = (  0.04594245985150691*u, 0.78777548370715300*u);
v5 = (  0.37032769638632340*u, 0.04492413699409305*u);
