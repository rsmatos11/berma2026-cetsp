v1 = (  0.97261420971711943*u, 0.08901825478746057*u);
v2 = (  0.34162820585986614*u, 0.20845866411667471*u);
v3 = (  0.27328613465890472*u, 0.13522144350868709*u);
v4 = (  0.02761639426313169*u, 0.06932547419520857*u);
