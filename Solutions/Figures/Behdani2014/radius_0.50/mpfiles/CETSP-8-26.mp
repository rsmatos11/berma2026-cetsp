v1 = (  0.39355052435033433*u, 0.46481465370123748*u);
v2 = (  0.18898748222067552*u, 0.61902456311270693*u);
v3 = (  0.11920516913206133*u, 0.52179994557169918*u);
v4 = (  0.22598202401169834*u, 0.33793897929080530*u);
