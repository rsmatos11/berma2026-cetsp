v1 = (  0.33605645014402613*u, 0.07463049036340455*u);
v2 = (  0.84694914978568092*u, 0.11328479291404979*u);
v3 = (  0.83476828193183883*u, 0.40420233916073584*u);
v4 = (  0.93393561313936468*u, 0.52308430083083168*u);
