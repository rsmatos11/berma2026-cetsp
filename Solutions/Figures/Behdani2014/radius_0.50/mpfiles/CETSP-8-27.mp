v1 = (  0.00409521341879176*u, 0.51181849174962502*u);
v2 = (  0.13504622386158460*u, 0.41243175038729030*u);
v3 = (  0.10140499758645846*u, 0.30109908461066409*u);
v4 = (  0.06877068553375154*u, 0.19309871248090821*u);
v5 = (  0.19677185304254738*u, 0.20156332320441839*u);
