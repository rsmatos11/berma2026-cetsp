r8 =  0.06987192476191142*u;
r9 =  0.00000000000000000*u;
v1 = (  0.74097778771511813*u, 0.08002850774530286*u);
v2 = (  0.65434428854505688*u, 0.25022419932119427*u);
v3 = (  0.59500435140337760*u, 0.27334847133085055*u);
v4 = (  0.53566441426162847*u, 0.29647274334050683*u);
v5 = (  0.14472159354411365*u, 0.44881985663294183*u);
v6 = (  0.04109983742417150*u, 0.48920037926334031*u);
