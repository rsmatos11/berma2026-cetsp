v1 = (  0.67868294127601969*u, 0.55435000282055624*u);
v2 = (  0.76558003913423034*u, 0.53390890961894288*u);
v3 = (  0.88497015542682067*u, 0.44847362507467425*u);
v4 = (  0.94074502596540588*u, 0.07155873898720877*u);
