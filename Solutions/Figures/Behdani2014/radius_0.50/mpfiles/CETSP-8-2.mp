r7 =  0.06079507803048265*u;
r8 =  0.06079507803048265*u;
r9 =  0.00000000000000000*u;
v1 = (  0.76195079246384201*u, 0.48794494397733551*u);
v2 = (  0.94881536046660209*u, 0.58558638261218210*u);
v3 = (  0.92541121324195819*u, 0.53271548276720959*u);
v4 = (  0.88095765505352996*u, 0.43229312598703845*u);
v5 = (  0.81833759293220731*u, 0.14998148897092170*u);
v6 = (  0.53118038251959110*u, 0.11622026803826441*u);
