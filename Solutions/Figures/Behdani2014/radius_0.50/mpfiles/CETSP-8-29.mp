v1 = (  0.07166664542360783*u, 0.24817160992645651*u);
v2 = (  0.21460648736613688*u, 0.12841612552353518*u);
v3 = (  0.58745578312164626*u, 0.07336137332685420*u);
v4 = (  0.62501072857520679*u, 0.15102935965477904*u);
v5 = (  0.68323028303478339*u, 0.27143415601864718*u);
v6 = (  0.94027368977325165*u, 0.54280740130727667*u);
