v1 = (  0.84546812784604719*u, 0.40552588875306500*u);
v2 = (  0.55923984688319861*u, 0.60332328603065333*u);
v3 = (  0.06287344595380558*u, 0.69405286066382155*u);
v4 = (  0.23752734171545606*u, 0.51108242381179092*u);
v5 = (  0.57644296175963461*u, 0.15602856838512516*u);
