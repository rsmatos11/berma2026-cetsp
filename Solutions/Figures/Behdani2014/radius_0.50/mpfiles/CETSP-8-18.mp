v1 = (  0.75720482538074285*u, 0.31466421809201156*u);
v2 = (  0.55489299417015492*u, 0.25736201661906727*u);
v3 = (  0.21054461582769213*u, 0.23835809597454330*u);
v4 = (  0.05212400446784663*u, 0.22961516899686540*u);
